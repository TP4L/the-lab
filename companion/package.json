  "private": true,
  "description": "THE LAB: shared backend and installable app for trainwiththelab.com. Accounts, athlete profiles, Scoreboard Studio and the Publishing Studio.",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
